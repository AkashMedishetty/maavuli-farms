# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# --- Mongo ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=maavuli

# --- Sessions ---
# 32+ random bytes. Rotating this logs everyone out and invalidates pending OTPs.
SESSION_SECRET=

# --- Razorpay (TEST keys until the refund policy is published) ---
# Razorpay will not activate live keys without a published refund/cancellation
# policy — see /legal/refunds. Test mode works without it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS for OTP ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Admin ---
# Comma-separated 10-digit mobiles. EMPTY = admin unreachable, which is the safe
# default. An open admin panel is a data breach, not a missing feature.
ADMIN_MOBILES=

# --- Delivery routing ---
# Where every delivery route starts — the farm. Optional: if unset, a rider with no
# start point of their own is routed from the centre of their own cluster of stops
# instead. Set both, or neither. (Rough Safilguda locality shown as an example.)
FARM_ORIGIN_LAT=
FARM_ORIGIN_LNG=

# --- Site ---
# Leave unset until the real host is known: a guessed hostname becomes a
# fabricated canonical URL that search engines act on.
NEXT_PUBLIC_SITE_URL=

# Show the OTP on screen in PRODUCTION, for demoing the flow before an SMS gateway
# exists. Set to 1 only for a client demo, and unset it before real customers.
#
# WARNING: with this on, anyone who can reach the site can sign in as any mobile
# number. Admin numbers are excluded — their code is minted and logged server-side
# but never returned to the browser — so the fulfilment panel stays protected.
OTP_DEMO_MODE=

# --- Scheduled jobs ---
# Vercel Cron calls /api/cron/tick every 5 minutes (vercel.json) and sends
# "Authorization: Bearer $CRON_SECRET". 32+ random bytes. Without it the tick
# endpoint refuses every call.
CRON_SECRET=

# --- e2e only ---
# Outside production, lets a request carry x-maavuli-now: <ISO> so tests can move
# time (cutoffs, day close). Ignored whenever NODE_ENV=production.
MAAVULI_TIME_TRAVEL=

# --- Delivery photos ---
# vercel-blob in production (a PRIVATE Blob store), local in development.
STORAGE_DRIVER=
BLOB_READ_WRITE_TOKEN=

# --- Google Maps Platform (route optimisation + customer location picker) ---
# Server key: Routes API only, restricted to the Routes API. Browser key: Maps
# JavaScript API + Places, restricted by HTTP referrer to the site's domain.
# Set per-API daily quotas in Cloud Console too — the caps below are the in-code
# backstop. Optimisation calls bill on "Compute Routes Pro" (5,000 free/month at
# global pricing); the defaults keep us under it. Without the keys: local route
# ordering + a free map picker.
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_ROUTES_DAILY_CAP=100
GOOGLE_ROUTES_MONTHLY_CAP=3000

# --- WhatsApp ---
# log (default): messages are recorded in the outbox and never sent.
# meta: WhatsApp Cloud API (or a Cloud-API-compatible provider via WHATSAPP_API_BASE).
WHATSAPP_PROVIDER=
WHATSAPP_API_BASE=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# webhook: X-Hub-Signature-256 is verified with the app secret; the verify token
# answers Meta's subscribe challenge.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# the approved authentication template used for sign-in codes
WHATSAPP_AUTH_TEMPLATE=
